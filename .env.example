# ---------------------------------------------------------------------------
# WallGold Data Monitor — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real secrets.
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API). Public values, safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Server-only. Used by the collector for inserts. NEVER prefix with NEXT_PUBLIC_
# and NEVER expose to client components.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Shared secret for the Vercel Cron endpoint /api/cron/wallgold.
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32  (or any long random string)
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional: reported by /api/health. Falls back to the package version.
NEXT_PUBLIC_APP_VERSION=0.1.0
